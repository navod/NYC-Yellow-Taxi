# Copy to .env and fill in real values:  cp .env.example .env
# .env is git-ignored. Never commit real passwords or secrets.
# Everything below the "Optional" line shows the built-in default (see etl/config.py).

# ------------------------------------------------------------ required: warehouse
DW_USER=dw_user
DW_PASSWORD=change-me
DW_DB=taxi_dw
# host port for PostgreSQL (5432 is often taken locally)
DW_PORT=5433

# --------------------------------------------- required: database and Airflow secrets
# PostgreSQL superuser
POSTGRES_PASSWORD=change-me
# Airflow metadata database role
AIRFLOW_DB_PASSWORD=change-me
# generate one: openssl rand -hex 32
AIRFLOW_JWT_SECRET=change-me
# NOTE: passwords only apply when the database volume is first created. To change one
# later, run ALTER ROLE inside the container (or `docker compose down -v` to start over).

# ------------------------------------------------------------------- docker / airflow
# Airflow UI: http://localhost:8081
AIRFLOW_PORT=8081
AIRFLOW_UID=50000

# ============================================================== Optional (defaults shown)

# --- paths (relative to the project root, or absolute)
RAW_DIR=data/raw
CLEAN_DIR=data/clean
SQL_DIR=sql

# --- data source
TLC_BASE_URL=https://d37ci6vzurychx.cloudfront.net
ZONE_LOOKUP_URL=https://d37ci6vzurychx.cloudfront.net/misc/taxi_zone_lookup.csv

# --- cleaning rules
MAX_TRIP_HOURS=24
MAX_TRIP_MILES=200
MAX_LOCATION_ID=265

# --- data quality
MAX_UNKNOWN_PAYMENT_SHARE=0.10

# --- warehouse connection
# Airflow Connection ID; must match AIRFLOW_CONN_NYC_TAXI_DW in docker-compose.yml
WAREHOUSE_CONN_ID=nyc_taxi_dw
APPLICATION_NAME=nyc_taxi_etl
DB_CONNECT_TIMEOUT_S=10
DB_STATEMENT_TIMEOUT=15min
DB_LOCK_TIMEOUT=60s
COPY_BATCH_ROWS=200000

# --- extract / alerts
DOWNLOAD_TIMEOUT_S=120
# Slack-compatible incoming webhook; empty = log only
ALERT_WEBHOOK_URL=
ALERT_TIMEOUT_S=10

# --- logging
ETL_LOG_LEVEL=INFO
# ETL_LOG_DIR is set for the containers by docker-compose.yml. Do not set it here:
# the container path does not exist on the host and breaks local runs and tests.

# --- DAG schedule and task behaviour
DAG_SCHEDULE=@monthly
DAG_START_DATE=2023-01-01
# extend to load more months
DAG_END_DATE=2023-02-28
DAG_CATCHUP=true
DAG_MAX_ACTIVE_RUNS=1
TASK_RETRIES=2
TASK_RETRY_DELAY_S=30
TASK_MAX_RETRY_DELAY_MIN=5
TASK_EXECUTION_TIMEOUT_MIN=30


SUPERSET_PORT=8088
SUPERSET_ADMIN_USER=admin
SUPERSET_ADMIN_PASSWORD=admin
SUPERSET_SECRET_KEY=local-dev-superset-secret-change-me